# Run bash deploy.sh to generate .env.docker.
PUBLIC_ORIGIN=http://127.0.0.1:3210
COMPENSATION_PORT=3210
# Existing container DNS name and internal port, not localhost.
NEWAPI_URL=http://new-api:3000
NEWAPI_NETWORK=new-api-network
NEWAPI_ADMIN_USER_ID=1
# Normal session duration in hours (1-720); the login checkbox uses 30 days.
SESSION_HOURS=8
# Explicit opt-in for the selected same-host private Docker network only.
ALLOW_HTTP_UPSTREAM=1
# Store token in secrets/newapi_admin_token, not in this file.
