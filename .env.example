HOST=127.0.0.1
PORT=3210
PUBLIC_ORIGIN=http://127.0.0.1:3210
# A single 云中猫API小站 instance. HTTPS or loopback HTTP only by default.
NEWAPI_URL=http://127.0.0.1:3000
# Server-side 云中猫API小站 management credential, never an inference sk- token.
NEWAPI_ADMIN_TOKEN=
NEWAPI_ADMIN_USER_ID=
DATA_DIR=./data
# Normal session duration in hours (1-720); the login checkbox uses 30 days.
SESSION_HOURS=8
# Set only for explicitly required private-network HTTP deployments.
ALLOW_HTTP_UPSTREAM=0
# Production reverse proxy must expose PUBLIC_ORIGIN over HTTPS.
